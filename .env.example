# Kopieer naar .env.local en vul in.
# Portal-ID en form-ID vind je in de embed-code van je HubSpot-formulier.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID=

# Zodra het echte domein bekend is (zie src/lib/site.ts):
NEXT_PUBLIC_SITE_URL=

# Indexering staat pas aan als DEZE twee dingen kloppen:
# 1. NEXT_PUBLIC_SITE_URL hierboven is ingevuld met het echte domein.
# 2. NEXT_PUBLIC_ENABLE_INDEXING=true — zet dit UITSLUITEND in de
#    Production-environment-variabelen van het Vercel-project (Vercel
#    Project Settings → Environment Variables → alleen "Production"
#    aanvinken, niet "Preview"/"Development"). Zo blijft elke
#    previewdeployment en lokale run altijd noindex, ook als die
#    NEXT_PUBLIC_SITE_URL wel erft.
NEXT_PUBLIC_ENABLE_INDEXING=
